---
import type { AboutProps, HeroProps } from "@types";
type Props = AboutProps & Pick<HeroProps, "name">;
const { description, image, name } = Astro.props;
const paragraphs = description.trim().split(/\n\s*\n/);
---

<section class="about-section" id="about" aria-labelledby="about-title">
  <div>
    <h2 id="about-title">About Me</h2><img
      class="portrait"
      src={image}
      width="260"
      height="280"
      alt={name}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="about-copy">
    {paragraphs.map((paragraph) => <p>{paragraph.trim()}</p>)}
  </div>
</section>
