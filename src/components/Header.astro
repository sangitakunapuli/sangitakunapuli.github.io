---
import type { HeaderProps } from "@types";
type Props = HeaderProps & { email: string };
const { navLinks, email } = Astro.props;
---

<header class="site-header">
  <a class="signature" href="#hero" aria-label="Sangita Kunapuli, home"
    >sangita<span aria-hidden="true">✳</span></a
  >
  <nav aria-label="Main navigation">
    {
      navLinks.map((link) => (
        <a href={link.href} data-nav-link>
          {link.text}
        </a>
      ))
    }
    <a class="contact-link" href={`mailto:${email}`}
      >Contact <span aria-hidden="true">↗</span></a
    >
  </nav>
</header>
<a class="skip-link" href="#main">Skip to content</a>
<script>
  import "../scripts/navigation";
</script>
