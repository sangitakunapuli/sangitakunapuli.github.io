---
import type { SiteConfig } from "@types";
type Props = Pick<SiteConfig, "author" | "socialLinks"> & { email: string };
const { author, socialLinks, email } = Astro.props;
---

<footer class="site-footer">
  <a class="footer-contact" href={`mailto:${email}`}
    >Contact me <span aria-hidden="true">↗</span></a
  >
  <ul>
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer">
            {text} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p>{author} © {new Date().getFullYear()}</p>
</footer>
