---
import type { ProjectProps } from "@types";
interface Props {
  projects: ProjectProps[];
}
const { projects } = Astro.props;
---

<section
  class="projects-section"
  id="projects"
  aria-labelledby="projects-title"
>
  <h2 id="projects-title">Featured <span>Projects</span></h2>
  <div class="gallery-controls">
    <div class="gallery-navigation">
      <span class="gallery-status" aria-live="polite" aria-atomic="true"></span>
      <button
        class="round-button"
        type="button"
        data-gallery-prev
        aria-label="Previous projects"
        aria-controls="project-gallery"
        disabled>←</button
      >
      <button
        class="round-button"
        type="button"
        data-gallery-next
        aria-label="Next projects"
        aria-controls="project-gallery">→</button
      >
    </div>
  </div>
  <div
    class="project-gallery"
    id="project-gallery"
    role="region"
    aria-label="Portfolio projects. Use arrow keys to browse."
    tabindex="0"
  >
    {
      projects.map((project, index) => {
        const isAR = project.name === "Object Recall in Augmented Reality";
        // The original AR preview duplicates the Splitzies video; retain the research slides instead.
        const preview =
          isAR && project.linkPreview === projects.find(({ name }) => name === "Splitzies")?.linkPreview
            ? undefined
            : project.linkPreview;
        return (
          <article
            class="project-card"
            id={isAR ? "project-ar" : `project-${index + 1}`}
            aria-labelledby={`project-title-${index}`}
          >
            <div class="project-image">
              <img
                src={project.image}
                alt={`${project.name} screenshot`}
                loading={index < 2 ? "eager" : "lazy"}
                decoding="async"
                width="736"
                height="483"
                draggable="false"
              />
            </div>
            <div class="project-copy">
              <h3 id={`project-title-${index}`}>{project.name}</h3>
              <p>{project.summary}</p>
            </div>
            <div class="project-meta">
              {project.tags?.length && (
                <ul class="project-tags" aria-label="Technologies">
                  {project.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
              <div class="project-links">
                {project.linkSource && (
                  <a
                    href={project.linkSource}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {isAR ? "Research slides" : "Source"}{" "}
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
                {preview && (
                  <a href={preview} target="_blank" rel="noopener noreferrer">
                    Preview <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
  <div class="project-selectors" role="group" aria-label="Select project">
    {
      projects.map((project, index) => (
        <button
          type="button"
          aria-controls="project-gallery"
          aria-label={project.name}
          aria-pressed={index === 0 ? "true" : "false"}
          data-project-index={index}
        >
          {String(index + 1).padStart(2, "0")}
        </button>
      ))
    }
  </div>
  <div class="github-more">
    <a
      href="https://github.com/sangitakunapuli?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      >More on GitHub <span aria-hidden="true">↗</span></a>
  </div>
</section>
<script>
  import "../scripts/projects";
</script>
