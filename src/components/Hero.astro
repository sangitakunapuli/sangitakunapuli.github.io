---
import type { HeroProps } from "@types";
type Props = HeroProps;
const { name, specialty, summary, email } = Astro.props;
const [firstName, ...lastName] = name.split(" ");
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <canvas class="mouse-ribbon" aria-hidden="true"></canvas>
  <div class="hero-copy">
    <p class="eyebrow">{specialty}</p>
    <h1 id="hero-title">{firstName}<br /><em>{lastName.join(" ")}.</em></h1>
    <p class="hero-summary">{summary}</p>
    <div class="hero-actions">
      <a class="primary-link" href="#projects">View projects <span aria-hidden="true">↓</span></a>
      <a class="primary-link" href={`mailto:${email}`}>Connect with me <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero-art">
    <a
      class="cube-link"
      href="#project-ar"
      aria-label="Explore my augmented reality research"
      data-ar-link
    >
      <span class="cube-glow" aria-hidden="true"></span>
      <span class="spatial-cube" aria-hidden="true">
        <span class="cube-face cube-back"></span><span
          class="cube-face cube-bottom"></span>
        <span class="cube-face cube-left"></span>
        <span class="spatial-item spatial-sphere"></span><span
          class="spatial-item spatial-block"></span>
        <span class="spatial-item spatial-ring"></span><span
          class="spatial-focus"></span>
        <span class="cube-face cube-right"></span><span
          class="cube-face cube-top"></span>
        <span class="cube-face cube-front"></span>
      </span>
    </a>
    <a
      class="cube-caption"
      href="https://arxiv.org/abs/2610.18183"
      target="_blank"
      rel="noopener noreferrer"
    >Read my paper from ISMAR 2026 (Honorable Mention) <span aria-hidden="true">↗</span></a>
  </div>
  <p class="hero-foot">Web · Mobile · Augmented Reality</p>
</section>
<script>
  import "../scripts/hero";
</script>
