---
import type { ExperienceProps } from "@types";
interface Props {
  experience: ExperienceProps[];
}
const { experience } = Astro.props;
---

<section
  class="experience-section"
  id="experience"
  aria-labelledby="experience-title"
>
  <h2 id="experience-title">Work <span>Experience</span></h2>
  <ol class="career-timeline" aria-label="Career timeline, latest roles first">
    {
      experience.map(({ company, position, startDate, endDate, summary }) => (
        <li class="timeline-entry">
          <div class="timeline-date">
            <span>{startDate}</span>
            <span>— {endDate}</span>
            {endDate === "Present" && (
              <span class="current-role">Current role</span>
            )}
          </div>
          <span class="timeline-line" aria-hidden="true" />
          <div class="timeline-body">
            <h3>{company}</h3>
            <h4>{position}</h4>
            {Array.isArray(summary) ? (
              <ul>
                {summary.map((log) => (
                  <li>{log}</li>
                ))}
              </ul>
            ) : (
              <p>{summary}</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
<script>
  import "../scripts/timeline";
</script>
